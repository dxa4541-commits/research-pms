# Copy this file to ".env" (same folder) and fill in your Supabase values — see docs/SUPABASE.md.
# ".env" is ignored by git: never commit your keys.

# Database: Supabase → Connect → "Session pooler" connection string (replace [YOUR-PASSWORD]).
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# File storage: Supabase project URL and secret (service_role) key.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
# SUPABASE_BUCKET=uploads

# Real use: no demo accounts, one admin with this password (8+ characters).
NODE_ENV=production
ADMIN_PASSWORD=change-me-please
# ADMIN_EMAIL=admin@example.com
